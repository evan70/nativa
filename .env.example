APP_ENV=local
APP_DEBUG=true

# Memcached
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211
MEMCACHED_PREFIX=nativa_db_

# Cache configuration
CACHE_ENABLED=true
CACHE_TTL=300  # seconds (5 minutes default)
CACHE_DRIVER=memcached  # memcached or file
CACHE_FILE_PATH=storage/cache

# Logging (set to true to enable file logging)
APP_LOG=true
