{
  "name": "@nativa/cardboard",
  "version": "0.0.1",
  "description": "Cardboard UI components for Vanilla Cards",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./article-editor": {
      "import": "./dist/article-editor/index.js",
      "types": "./dist/article-editor/index.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "components",
    "article-editor",
    "vanilla-cards"
  ],
  "author": "Nativa",
  "license": "MIT",
  "peerDependencies": {
    "htmx.org": "^2.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "htmx.org": "^2.0.10",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^8.0.11",
    "vitest": "^3.2.6"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}