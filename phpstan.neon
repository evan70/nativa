# PHPStan configuration
parameters:
    level: max
    paths:
        - app
        - modules/blog/src
        - modules/database-modular/src
        - modules/mark/src
    excludePaths:
        - vendor
        - packages
        - modules/blog/Seed
        - modules/blog/tests
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Class Marko\\Authentication\\DefaultUserProvider not found#'
        - '#Offset.*always exists#'
        - '#Variable \$_POST on left side of \?\?#'
        - '#Parameter.*storagePath.*implicitly nullable#'
        - '#Property.*ModuleConnection.*pdo#'
        - '#comparison.*PDO and null#'
