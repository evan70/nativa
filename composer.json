{
    "name": "marko/skeleton",
    "description": "Marko Framework - Application Skeleton",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "psr/container": "^2.0",
        "ext-memcached": "*",
        "marko/framework": "dev-main",
        "marko/admin": "dev-main",
        "marko/database": "dev-main",
        "marko/authentication": "dev-main",
        "marko/session": "dev-main",
        "marko/log": "dev-main",
        "marko/mail": "dev-main",
        "marko/notification": "dev-main",
        "marko/queue": "dev-main",
        "marko/amphp": "dev-main",
        "marko/testing": "dev-main",
        "marko/dev-server": "dev-main",
        "marko/layout": "dev-main",
        "marko/view": "dev-main",
        "marko/env": "dev-main",
        "marko/log-file": "dev-main",
        "marko/notification-database": "dev-main",
        "marko/session-database": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "App\\": "modules/controllers/src/",
            "Marko\\Cardboard\\": "modules/cardboard/src/",
            "App\\Blog\\": "modules/blog/src/",
            "Marko\\Mark\\": "modules/mark/src/",
            "App\\Htmx\\": "modules/htmx/src/",
            "App\\Portfolio\\": "modules/portfolio/src/",
            "App\\ViewSimple\\": "modules/view-simple/src/",
            "App\\Init\\": "modules/init/src/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --parallel --stop-on-failure",
        "analyse": "phpstan analyse --memory-limit=1G --error-format=table",
        "check": [
            "@validate",
            "@analyse",
            "@test"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:9000 -t public"
        ],
        "build": "php build.php"
    }
}
