{
    "name": "marko/skeleton",
    "description": "Marko Framework - Application Skeleton",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/database": "self.version",
        "marko/notification": "self.version"
    },
    "replace": {
        "marko/admin": "*",
        "marko/admin-api": "*",
        "marko/admin-auth": "*",
        "marko/admin-panel": "*",
        "marko/authentication": "*",
        "marko/authorization": "*",
        "marko/cli": "*",
        "marko/config": "*",
        "marko/env": "*",
        "marko/errors": "*",
        "marko/errors-advanced": "*",
        "marko/errors-simple": "*",
        "marko/hashing": "*",
        "marko/log": "*",
        "marko/log-file": "*",
        "marko/mail": "*",
        "marko/notification-database": "*",
        "marko/psr-container": "*",
        "marko/queue": "*",
        "marko/routing": "*",
        "marko/session": "*",
        "marko/session-database": "*",
        "marko/testing": "*",
        "marko/validation": "*",
        "marko/view": "*",
        "marko/amphp": "*",
        "marko/dev-server": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
