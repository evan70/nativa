{
    "name": "marko/skeleton",
    "description": "Marko Framework - Application Skeleton",
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "canonical": true
        }
    ],
    "require": {
        "php": "^8.5",
        "marko/env": "*@dev",
        "marko/core": "*@dev",
        "marko/cli": "*@dev",
        "marko/config": "*@dev",
        "marko/database": "*@dev",
        "marko/hashing": "*@dev",
        "marko/routing": "*@dev",
        "marko/validation": "*@dev",
        "marko/errors": "*@dev",
        "marko/errors-simple": "*@dev",
        "marko/session-database": "dev-main",
        "marko/session-file": "dev-main"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "marko/testing": "*@dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
