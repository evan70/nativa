<div class="stack">
    <div class="eyebrow">Journal</div>
    <h1><?= htmlspecialchars($title ?? 'Blog', ENT_QUOTES, 'UTF-8') ?></h1>
    <p><?= htmlspecialchars($message ?? '', ENT_QUOTES, 'UTF-8') ?></p>
    <div class="actions">
        <a class="button" href="/articles/new">New Article</a>
    </div>

    <?php if (($articles ?? []) === []): ?>
        <div class="card">
            <h2>No posts yet</h2>
            <p>Start the journal with your first article.</p>
        </div>
    <?php else: ?>
        <div class="cards">
            <?php foreach ($articles as $article): ?>
                <article class="card">
                    <h2>
                        <a href="/blog/<?= (int) ($article->id ?? 0) ?>">
                            <?= htmlspecialchars($article->title, ENT_QUOTES, 'UTF-8') ?>
                        </a>
                    </h2>
                    <p class="meta">
                        <?= htmlspecialchars($article->createdAt ?? 'Draft', ENT_QUOTES, 'UTF-8') ?>
                    </p>
                </article>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>
