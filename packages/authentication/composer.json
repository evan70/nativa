{
    "name": "marko/authentication",
    "description": "Authentication and authorization for Marko Framework",
    "type": "marko-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Marko\\Authentication\\": "src/"
        }
    },
    "extra": {
        "marko": {
            "module": true,
            "group": "auth",
            "routes": ["/login", "/register", "/logout", "/api/auth/*"],
            "idleTimeout": "30m"
        }
    }
}
